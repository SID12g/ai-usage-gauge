{
  "name": "ai-usage-statusbar-by-sid12g",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "sid12g",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1E1F2E",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SID12g/ai-usage-statusbar.git"
  },
  "bugs": {
    "url": "https://github.com/SID12g/ai-usage-statusbar/issues"
  },
  "homepage": "https://github.com/SID12g/ai-usage-statusbar#readme",
  "keywords": [
    "claude",
    "claude code",
    "anthropic",
    "chatgpt",
    "codex",
    "openai",
    "usage",
    "usage limits",
    "rate limit",
    "quota",
    "status bar",
    "statusbar"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./extension.js",
  "l10n": "./l10n",
  "files": [
    "extension.js",
    "media/**",
    "l10n/**",
    "package.nls.json",
    "package.nls.*.json",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "ai-usage-claude": {
        "description": "%icon.claude%",
        "default": {
          "fontPath": "./media/ai-logos.woff",
          "fontCharacter": "\\E001"
        }
      },
      "ai-usage-chatgpt": {
        "description": "%icon.chatgpt%",
        "default": {
          "fontPath": "./media/ai-logos.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "commands": [
      {
        "command": "aiUsage.refresh",
        "title": "%command.refresh%",
        "category": "%category%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "aiUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 60,
          "description": "%config.refreshIntervalSeconds%"
        },
        "aiUsage.showClaude": {
          "type": "boolean",
          "default": true,
          "description": "%config.showClaude%"
        },
        "aiUsage.showChatGPT": {
          "type": "boolean",
          "default": true,
          "description": "%config.showChatGPT%"
        },
        "aiUsage.codexPath": {
          "type": "string",
          "default": "",
          "description": "%config.codexPath%"
        }
      }
    }
  }
}

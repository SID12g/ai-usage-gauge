{
  "name": "ai-usage-statusbar",
  "displayName": "AI 사용량 상태 표시줄",
  "description": "Claude와 ChatGPT(Codex)의 남은 사용량을 하단 상태 표시줄에 보여줍니다.",
  "version": "0.2.1",
  "publisher": "sid12g",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "icons": {
      "ai-usage-claude": {
        "description": "Claude 로고",
        "default": {
          "fontPath": "./media/ai-logos.woff",
          "fontCharacter": "\\E001"
        }
      },
      "ai-usage-chatgpt": {
        "description": "ChatGPT 로고",
        "default": {
          "fontPath": "./media/ai-logos.woff",
          "fontCharacter": "\\E002"
        }
      }
    },
    "commands": [
      {
        "command": "aiUsage.refresh",
        "title": "새로고침",
        "category": "AI 사용량"
      }
    ],
    "configuration": {
      "title": "AI 사용량",
      "properties": {
        "aiUsage.refreshIntervalSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 60,
          "description": "사용량을 다시 조회하는 간격(초). 여러 VS Code 창이 열려 있어도 이 간격 안에서는 조회 결과를 공유합니다."
        },
        "aiUsage.showClaude": {
          "type": "boolean",
          "default": true,
          "description": "상태 표시줄에 Claude 사용량을 표시합니다."
        },
        "aiUsage.showChatGPT": {
          "type": "boolean",
          "default": true,
          "description": "상태 표시줄에 ChatGPT(Codex) 사용량을 표시합니다."
        },
        "aiUsage.codexPath": {
          "type": "string",
          "default": "",
          "description": "codex 실행 파일 경로. 비워 두면 PATH와 흔한 설치 위치(Homebrew, pnpm, npm 등)에서 찾습니다."
        }
      }
    }
  }
}
